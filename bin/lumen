#!/usr/bin/env bash
# Launcher for running Lumen from a source checkout.
set -euo pipefail

# Resolve symlinks so this can be linked into ~/.local/bin.
source="${BASH_SOURCE[0]}"
while [[ -L "$source" ]]; do
  base="$(cd -P -- "$(dirname -- "$source")" && pwd)"
  source="$(readlink "$source")"
  [[ "$source" != /* ]] && source="$base/$source"
done

root="$(cd -P -- "$(dirname -- "$source")/.." && pwd)"
python="$root/.venv/bin/python"

if [[ ! -x "$python" ]]; then
  printf 'Lumen: virtualenv missing. Run %s/setup.sh first.\n' "$root" >&2
  exit 1
fi

cd -- "$root"

# Qt's Wayland text-input backend logs harmless focus warnings on wlroots
# compositors ("disableSurface ... but 0x0 is focused").  Keep the console
# quiet unless the user has supplied their own logging rules.
export QT_LOGGING_RULES="${QT_LOGGING_RULES:-qt.qpa.wayland.textinput=false}"

exec "$python" -m lumen "$@"
